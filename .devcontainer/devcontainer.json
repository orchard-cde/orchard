{
  "name": "orchard",
  "image": "mcr.microsoft.com/devcontainers/java:25-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "postCreateCommand": "./gradlew --version",
  "postStartCommand": "echo started > /tmp/orchard-poststart",
  "secrets": {
    "ORCHARD_E2E_SECRET": {
      "description": "Set by the Orchard e2e suite; harmless when absent."
    }
  }
}
